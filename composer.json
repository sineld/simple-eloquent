{
    "name": "sineld/simple-eloquent",
    "description": "Hydration-free Eloquent queries: retrieve results as plain objects with full relation support",
    "license": "MIT",
    "keywords": [
        "laravel",
        "eloquent",
        "performance",
        "hydration"
    ],
    "homepage": "https://github.com/sineld/simple-eloquent",
    "authors": [
        {
            "name": "Andrey Volosyuk",
            "email": "valasiuk.andrei@gmail.com",
            "role": "Original author"
        },
        {
            "name": "Sinan Eldem",
            "email": "sinan@sinaneldem.com.tr",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0|^14.0",
        "illuminate/support": "^12.0|^13.0|^14.0",
        "illuminate/pagination": "^12.0|^13.0|^14.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Volosyuk\\SimpleEloquent\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "lint:fix": "pint",
        "stan": "phpstan analyse",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
